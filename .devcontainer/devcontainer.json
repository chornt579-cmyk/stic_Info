{
  "name": "STIC Info — Firebase Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",

  // Install Java (required for Firestore Emulator), Firebase CLI + tools on container start
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y default-jre && npm install -g firebase-tools && cd functions && npm install",
  "postStartCommand": "echo '✅ STIC Info dev environment ready. Run: firebase emulators:start'",

  // Forward all Firebase Emulator ports
  "forwardPorts": [4000, 5000, 5001, 8080, 9099],
  "portsAttributes": {
    "4000": { "label": "Firebase Emulator UI",  "onAutoForward": "notify" },
    "5000": { "label": "Firebase Hosting",      "onAutoForward": "openBrowser" },
    "5001": { "label": "Cloud Functions",        "onAutoForward": "silent" },
    "8080": { "label": "Firestore Emulator",    "onAutoForward": "silent" },
    "9099": { "label": "Auth Emulator",         "onAutoForward": "silent" }
  },

  // VS Code extensions for the project
  "customizations": {
    "vscode": {
      "extensions": [
        "toba.vsfire",
        "mtxr.sqltools",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "ritwickdey.LiveServer",
        "ms-vscode.live-server"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2,
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash",
        "liveServer.settings.port": 5500
      }
    }
  },

  // Environment variables (non-secret)
  "remoteEnv": {
    "FIREBASE_EMULATORS": "true",
    "NODE_ENV": "development"
  }
}

